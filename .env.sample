# =============================================================================
# onsen_tabi 環境変数設定ファイル
# =============================================================================
#
# このファイルをコピーして .env ファイルを作成してください:
#   cp .env.sample .env
#
# セキュリティ注意事項:
# - .env ファイルは絶対にGitにコミットしないでください
# - 本番環境では環境変数を直接設定することを推奨します
#

# -----------------------------------------------------------------------------
# データベース設定
# -----------------------------------------------------------------------------
# MySQL接続URL
# フォーマット: mysql://[ユーザー名]:[パスワード]@[ホスト]:[ポート]/[データベース名]
#
# ローカル開発環境の例:
#   DATABASE_URL=mysql://root:password@localhost:3306/onsen_tabi
#
# 本番環境 (AWS RDS) の例:
#   DATABASE_URL=mysql://admin:SecurePass123@onsen-tabi.xxx.ap-northeast-1.rds.amazonaws.com:3306/onsen_tabi
#
DATABASE_URL=mysql://root:password@localhost:3306/onsen_tabi

# -----------------------------------------------------------------------------
# テスト用データベース設定
# -----------------------------------------------------------------------------
# テスト実行時に使用するデータベース接続URL
# 
# 推奨設定:
# - 開発用データベースとは別のテスト専用データベースを使用
# - テストデータで本番データが汚染されないようにする
#
# テスト用データベースの作成:
#   mysql -u root -p
#   CREATE DATABASE onsen_tabi_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   GRANT ALL PRIVILEGES ON onsen_tabi_test.* TO 'root'@'localhost';
#   FLUSH PRIVILEGES;
#
# マイグレーション実行（テストDB用）:
#   DATABASE_URL=mysql://root:password@localhost:3306/onsen_tabi_test diesel migration run
#
TEST_DATABASE_URL=mysql://root:password@localhost:3306/onsen_tabi_test

# -----------------------------------------------------------------------------
# JWT認証設定
# -----------------------------------------------------------------------------
# JWT署名用のシークレットキー
# 
# 要件:
# - 最低32文字以上のランダムな文字列を使用
# - 英数字と記号を組み合わせること
# - 環境ごとに異なる値を設定すること
#
# シークレットキーの生成方法:
#   openssl rand -base64 32
#   または
#   head -c 32 /dev/urandom | base64
#
# ⚠️ 警告:
# - 本番環境では必ず強力なランダム文字列を設定してください
# - このキーが漏洩するとセキュリティ上の重大な問題となります
# - 定期的にローテーションすることを推奨します
#
JWT_SECRET_KEY=your-secret-key-here-please-change-in-production

# -----------------------------------------------------------------------------
# サーバー設定 (Rocket.toml で設定可能)
# -----------------------------------------------------------------------------
# 以下の設定は Rocket.toml で管理していますが、環境変数で上書き可能です
#
# ROCKET_ADDRESS=0.0.0.0
# ROCKET_PORT=8000
# ROCKET_LOG_LEVEL=normal

# -----------------------------------------------------------------------------
# CORS設定
# -----------------------------------------------------------------------------
# 許可するオリジン（単一のオリジンを指定）
# 
# 重要: Access-Control-Allow-Credentials: true を使用する場合、
# ワイルドカード (*) は使用できません。特定のオリジンを指定する必要があります。
#
# 開発環境の例:
#   CORS_ALLOWED_ORIGIN=http://localhost:3000
#
# 本番環境の例:
#   CORS_ALLOWED_ORIGIN=https://yourdomain.com
#
# デフォルト値（未設定時）: http://localhost:3000
#
CORS_ALLOWED_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# ログ設定
# -----------------------------------------------------------------------------
# ログレベル: error, warn, info, debug, trace
# 本番環境では info または warn を推奨
#
# RUST_LOG=info

# -----------------------------------------------------------------------------
# その他の設定
# -----------------------------------------------------------------------------
# バックトレース表示 (開発環境のみ)
# RUST_BACKTRACE=1
